#!/usr/bin/env zsh
# 📚 Exploración del historial: log, archivo, commit, búsqueda, blame y qué trae tu rama
source ${0:A:h}/lib/ui.zsh
require_repo
banner "📚 Git History" 4

pick_file() { git ls-files | gum filter --placeholder "Selecciona un archivo" }
pick_dir()  { git ls-files | sed -n 's|/[^/]*$||p' | sort -u | gum filter --placeholder "Selecciona un directorio" }

BASE=$(base_branch)
OPTION=$(gum choose \
  "Historial general" \
  "Commits de mi rama (vs $BASE)" \
  "Archivos que cambia mi rama (vs $BASE)" \
  "Historial de archivo" \
  "Historial de directorio" \
  "Ver commit" \
  "Buscar texto en cambios" \
  "Buscar en mensajes" \
  "Git blame" \
  "Archivos modificados recientemente") || exit 0

# git usa su propio pager con colores (delta si lo configuraste)
case $OPTION in
  "Historial general")  git log --graph --decorate --oneline --all ;;
  "Commits de mi rama"*)
    git log --decorate --format='%C(yellow)%h%C(reset) %s %C(dim)(%ar · %an)%C(reset)' origin/$BASE..HEAD ;;
  "Archivos que cambia mi rama"*)
    git diff --stat origin/$BASE...HEAD ;;
  "Historial de archivo")
    FILE=$(pick_file) || exit 0
    git log --follow -p -- $FILE ;;
  "Historial de directorio")
    DIR=$(pick_dir) || exit 0
    git log --stat -- $DIR ;;
  "Ver commit")
    COMMIT=$(git log --all --format='%h %s (%ar · %an)' -n 500 | gum filter --placeholder "buscar commit...") || exit 0
    git show --stat -p ${COMMIT%% *} ;;
  "Buscar texto en cambios")
    TEXT=$(gum input --placeholder "Texto agregado o quitado en algún commit") || exit 0
    [[ -n $TEXT ]] && git log -S "$TEXT" --oneline --decorate --all ;;
  "Buscar en mensajes")
    TEXT=$(gum input --placeholder "Texto en el mensaje del commit") || exit 0
    [[ -n $TEXT ]] && git log -i --grep="$TEXT" --oneline --decorate --all ;;
  "Git blame")
    FILE=$(pick_file) || exit 0
    git blame --date=short -- $FILE ;;
  "Archivos modificados recientemente")
    git log --no-merges --name-only --format= -n 30 | sed '/^$/d' | sort | uniq -c | sort -nr | ${PAGER:-less} ;;
esac
