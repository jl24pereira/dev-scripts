#!/usr/bin/env zsh
# 🚀 Push de la rama actual; publica ramas nuevas (-u) y ofrece salida si el remoto rechaza
source ${0:A:h}/lib/ui.zsh
require_repo
banner "🚀 Git Push"

BRANCH=$(git branch --show-current)
[[ -n $BRANCH ]] || { err "Estás en detached HEAD"; exit 1 }
REMOTE=${GIT_REMOTE:-origin}
info "🌿 Rama: $BRANCH"

if has_upstream; then
  PENDING=$(git log --oneline '@{u}..HEAD')
  [[ -n $PENDING ]] || { ok "No hay commits pendientes de pushear"; exit 0 }
  UPSTREAM_FLAG=()
else
  PENDING=$(git log --oneline -n 30 HEAD --not --remotes)
  warn "La rama aún no existe en $REMOTE: se publicará con seguimiento (-u)"
  UPSTREAM_FLAG=(-u)
fi
echo

if [[ -n $PENDING ]]; then
  info "📌 Commits por pushear:"
  print -r -- $PENDING | sed 's/^/  /'
  echo
fi

if [[ $BRANCH == (main|master|develop|release/*) ]]; then
  gum confirm --default=false "⚠ Vas a pushear directo a $BRANCH. ¿Seguro?" || cancel
else
  gum confirm "¿Hacer push a $REMOTE/$BRANCH?" || cancel
fi

push() {
  if run "Pusheando" git push "$@" $UPSTREAM_FLAG $REMOTE $BRANCH; then
    ok "Push realizado a $REMOTE/$BRANCH"
    # GitHub / Azure DevOps sugieren el enlace para crear el PR
    grep -oE 'https?://[^ ]+' $UI_LOG | grep -Ei 'pull|pullrequest' | head -1 | sed 's/^/🔗 PR: /'
    return 0
  fi
  return 1
}

push && exit 0
grep -qE 'rejected|non-fast-forward|fetch first' $UI_LOG || exit 1

ACTION=$(gum choose --header "El remoto tiene commits que no tienes" \
  "Pull con rebase y reintentar" "Forzar con --force-with-lease" "Cancelar") || cancel
case $ACTION in
  Pull*)   run "Rebase sobre $REMOTE/$BRANCH" git pull --rebase $REMOTE $BRANCH \
             || { err "Resuelve conflictos y luego: git rebase --continue (o --abort)"; exit 1 }
           push ;;
  Forzar*) gum confirm --default=false "Esto reescribe $REMOTE/$BRANCH. ¿Seguro?" && push --force-with-lease ;;
  *)       cancel ;;
esac

