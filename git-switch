#!/usr/bin/env zsh
# 🔀 Cambia de rama (locales y remotas, las más recientes primero) con manejo de cambios sin commit
source ${0:A:h}/lib/ui.zsh
require_repo
banner "🌿 Git Switch"

quick_fetch --all
CURRENT=$(git branch --show-current)

local -a local_br remote_br items
local_br=(${(f)"$(git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads)"})
remote_br=(${(f)"$(git for-each-ref --sort=-committerdate --format='%(refname:lstrip=3)' refs/remotes | grep -vx HEAD)"})

PREV=$(git rev-parse --abbrev-ref '@{-1}' 2>/dev/null)
[[ -n $PREV && $PREV != '@{-1}' ]] && items+="↩ $PREV  [anterior]"
for b in ${(u)local_br} ${(u)remote_br}; do
  [[ $b == $CURRENT ]] && continue
  if (( ${local_br[(Ie)$b]} && ${remote_br[(Ie)$b]} )); then items+="$b  [local+remota]"
  elif (( ${local_br[(Ie)$b]} )); then items+="$b  [local]"
  else items+="$b  [remota]"
  fi
done
items=(${(u)items})
(( $#items )) || { warn "No hay otras ramas"; exit 0 }

SELECTED=$(print -rl -- $items | gum filter --header "🌿 Rama (actual: $CURRENT)" --placeholder "buscar...") || cancel
BRANCH=${${SELECTED#↩ }%%  *}

if is_dirty; then
  ACTION=$(gum choose --header "Tienes cambios sin commit" "Llevarlos a $BRANCH" "Guardarlos en stash" "Cancelar") || cancel
  case $ACTION in
    Guardar*) run "Guardando stash" git stash push -u -m "git-switch: desde $CURRENT" || exit 1
              dim "Recupéralos en $CURRENT con: git stash pop" ;;
    Cancelar) cancel ;;
  esac
fi

run "Cambiando a $BRANCH" git switch $BRANCH || exit 1
ok "Cambiado a rama: $BRANCH"

if has_upstream; then
  BEHIND=$(git rev-list --count 'HEAD..@{u}')
  (( BEHIND )) && gum confirm "Está $BEHIND commit(s) atrás del remoto. ¿Hacer pull?" \
    && run "Actualizando" git pull --ff-only && ok "Actualizada"
fi
exit 0

