#!/usr/bin/env zsh
# 🐘 Menú de tasks de Gradle (incluye bootRun con perfil, un test y Sonar)
source ${0:A:h}/lib/ui.zsh
banner "🐘 Gradle Runner"

[[ -f build.gradle || -f build.gradle.kts || -f settings.gradle || -f settings.gradle.kts ]] \
  || { err "No hay build.gradle en esta carpeta (corre desde la raíz del proyecto)"; exit 1 }

if [[ -x ./gradlew ]]; then GRADLE=(./gradlew)
elif [[ -f ./gradlew ]]; then
  GRADLE=(sh ./gradlew)   # sin chmod: no ensuciar git
  dim "gradlew sin permiso de ejecución. Arreglo permanente: git update-index --chmod=+x gradlew"
else GRADLE=(gradle)
fi

TASK=$(gum filter --header "🔧 Task de Gradle" --placeholder "buscar..." \
  "build" "clean build" "build -x test" "bootRun" "bootRun (perfil local)" \
  "test" "clean test" "test (una clase)" "bootJar" "dependencies" "sonar") || cancel

case $TASK in
  "bootRun (perfil local)")
    PROFILE=$(gum input --header "Perfil" --value "${SPRING_PROFILE:-local}") || cancel
    CMD=(bootRun --args="--spring.profiles.active=$PROFILE") ;;
  "test (una clase)")
    CLASS=$(gum input --header "Clase o patrón" --placeholder "HolaControllerTest o *Controller*") || cancel
    CMD=(test --tests "*$CLASS*") ;;
  dependencies) CMD=(dependencies --configuration runtimeClasspath) ;;
  sonar)
    # El plugin de Sonar lee SONAR_HOST_URL y SONAR_TOKEN del entorno: el token nunca va en la línea de comandos
    export SONAR_HOST_URL=${SONAR_HOST_URL:-$SONAR_HOST}
    [[ -n $SONAR_HOST_URL && -n $SONAR_TOKEN ]] || { err "Define SONAR_HOST (o SONAR_HOST_URL) y SONAR_TOKEN"; exit 1 }
    NAME=${PWD:t}
    CMD=(clean test sonar -Dsonar.branch.name=${SONAR_BRANCH:-develop}
         -Dsonar.projectKey=${NAME}_CI -Dsonar.projectVersion=Local$(date +%d%m%Y).1) ;;
  *) CMD=(${=TASK}) ;;
esac

info "⚙  ${GRADLE[-1]} ${(j: :)${(q-)CMD}}"
echo

if [[ $CMD[1] == bootRun ]]; then
  $GRADLE $CMD; exit $?
fi

$GRADLE $CMD 2>&1 | tee $UI_LOG
CODE=${pipestatus[1]}
echo
if (( CODE == 0 )); then ok "gradle $TASK completado"
else err "gradle $TASK falló"
fi
gum confirm --default=$(( CODE != 0 )) "¿Ver log completo?" && gum pager <$UI_LOG
exit $CODE

