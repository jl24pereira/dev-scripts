#!/usr/bin/env zsh
# 🌿 Crea una rama con prefijo (feature/, bugfix/...) desde la base actualizada o la rama actual
source ${0:A:h}/lib/ui.zsh
require_repo
banner "🌿 Crear Rama"

CURRENT=$(git branch --show-current)
BASE=$(base_branch)

PREFIX=$(gum choose --header "🏷  Tipo de rama" ${=${BRANCH_PREFIXES:-feature bugfix hotfix release chore}} "(sin prefijo)") || cancel
[[ $PREFIX == "(sin prefijo)" ]] && PREFIX=""

NAME=$(gum input --header "📝 Nombre" --placeholder "1234-descripcion-corta") || cancel
NAME=${${NAME// /-}//[^A-Za-z0-9._\/-]/}      # espacios → guiones, sin caracteres inválidos
[[ -n $NAME ]] || cancel
NEW=${PREFIX:+$PREFIX/}$NAME

git check-ref-format --branch $NEW >/dev/null 2>&1 || { err "Nombre de rama inválido: $NEW"; exit 1 }
git show-ref -q --verify refs/heads/$NEW && { err "La rama $NEW ya existe localmente"; exit 1 }
git show-ref -q --verify refs/remotes/origin/$NEW && warn "Ya existe origin/$NEW (git-switch la trae)"

local -a opts
[[ -n $BASE ]] && opts+="origin/$BASE (actualizada)"
[[ -n $CURRENT && $CURRENT != $BASE ]] && opts+="$CURRENT (rama actual)"
opts+="Otra rama..."
FROM=$(gum choose --header "📍 Crear desde" $opts) || cancel

case $FROM in
  origin/*)
    run "Actualizando origin/$BASE" timeout 30 git fetch origin $BASE || exit 1
    START=origin/$BASE ;;
  "Otra rama...")
    START=$(git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads refs/remotes \
      | grep -v '/HEAD$' | gum filter --header "📍 Rama base") || cancel ;;
  *) START=$CURRENT ;;
esac

is_dirty && dim "Tus cambios sin commit se llevan a la rama nueva."
run "Creando $NEW desde $START" git switch -c $NEW --no-track $START || exit 1
ok "Rama creada: $NEW"
info "📍 Basada en: $START"

gum confirm --default=false "¿Publicarla ya en origin?" && run "Publicando" git push -u origin $NEW && ok "Publicada: origin/$NEW"
exit 0
