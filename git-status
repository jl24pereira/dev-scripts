#!/usr/bin/env zsh
# 📊 Estado del repo: rama, sincronía con el remoto, último commit y archivos por estado
source ${0:A:h}/lib/ui.zsh
require_repo
banner "📊 Git Status"

quick_fetch

BRANCH=$(git branch --show-current)
[[ -z $BRANCH ]] && BRANCH="(detached en $(git rev-parse --short HEAD))"
info "🌿 Rama: $BRANCH"

if has_upstream; then
  read BEHIND AHEAD < <(git rev-list --left-right --count '@{u}...HEAD')
  if (( AHEAD && BEHIND )); then gum style --foreground 1 "⚠ $AHEAD adelante, $BEHIND atrás de $(git rev-parse --abbrev-ref '@{u}')"
  elif (( AHEAD ));         then gum style --foreground 3 "⬆ $AHEAD commit(s) por pushear"
  elif (( BEHIND ));        then gum style --foreground 1 "⬇ $BEHIND commit(s) por pullear"
  else ok "Sincronizado con $(git rev-parse --abbrev-ref '@{u}')"
  fi
else
  warn "La rama no está publicada en el remoto (git-push la publica)"
fi
STASHES=$(git stash list | wc -l)
(( STASHES )) && dim "📦 $STASHES stash(es) guardado(s)"
echo

if git rev-parse -q --verify HEAD >/dev/null; then
  info "📌 Último commit:"
  git --no-pager log -1 --color=always --format='  %C(yellow)%h%C(reset) %s %C(dim)(%ar · %an)%C(reset)'
  BODY=$(git log -1 --format=%b)
  [[ -n $BODY ]] && print -r -- $BODY | sed 's/^/    /'
  echo
fi

# Archivos por estado (porcelain: XY ruta; respeta espacios y renombrados)
local -a staged modified deleted untracked conflicts
local line xy f
for line in ${(f)"$(git status --porcelain)"}; do
  xy=${line[1,2]} f=${line[4,-1]}
  if [[ $xy == '??' ]]; then untracked+=$f
  elif [[ $xy == *U* || $xy == (AA|DD) ]]; then conflicts+=$f
  else
    [[ ${xy[1]} != ' ' ]] && staged+="${xy[1]} $f"
    [[ ${xy[2]} == M ]] && modified+=$f
    [[ ${xy[2]} == D ]] && deleted+=$f
  fi
done

show() {  # color etiqueta archivos...
  local color=$1 label=$2; shift 2
  (( $# )) || return 0
  gum style --foreground $color "$label ($#)"
  print -rl -- "  "${^@}
  echo
}
show 1 "💥 En conflicto" $conflicts
show 2 "✅ En stage"     $staged
show 3 "✏  Modificados"  $modified
show 1 "🗑  Eliminados"   $deleted
show 4 "➕ Nuevos"        $untracked

(( $#staged + $#modified + $#deleted + $#untracked + $#conflicts )) || ok "Árbol de trabajo limpio"
STATS=$(git diff --cached --shortstat)
[[ -n $STATS ]] && info "📈 En stage:$STATS"

