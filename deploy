  "🔌 Port-forward|forward"
  "☁  Ver recursos en Floci|aws"
  "🔀 Cambiar proyecto|project"
  "📄 Ver último log|log"
  "⏸  Pausar ambiente|pause"
  "🗑  Eliminar|destroy"
  "👋 Salir|exit"
)

while true; do
  header
  choice=$(gum choose --cursor "➜ " --height 16 ${MENU%%\|*}) || break
  for m in $MENU; do [[ ${m%%\|*} == $choice ]] && { action=${m##*\|}; break } done
  [[ $action == exit ]] && break
  cmd_$action
  echo; gum input --placeholder "Enter para volver al menú" >/dev/null || break
  clear
done
