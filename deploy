#!/usr/bin/env zsh
# ☁ dev — ambiente local: k3d (en lugar de EKS) + Floci (en lugar de AWS)
#
# Uso:
#   dev                              menú interactivo
#   dev [-p proyecto] <acción>       acción directa
#
# Acciones:
#   on  [all|floci|k3d]          enciende (y arranca Docker si hace falta)
#   off [all|floci|k3d|docker]   apaga sin borrar nada; 'docker' también apaga Docker
#   power                        interruptor: ofrece encender/apagar según el estado
#   deploy    compila (Gradle), construye imagen, importa a k3d y aplica manifiestos
#   apply     solo renderiza y aplica manifiestos (reinicia pods igual)
#   status    estado del proyecto actual         overview  resumen de todos los proyectos
#   logs      logs del pod                       forward   port-forward
#   diagnose  por qué el pod no arranca (motivo, eventos, logs del intento anterior)
#   destroy   elimina clúster (y opcionalmente Floci)
#   render <dir_k8s> [ambiente] [salida]         rellena $(variables) desde vars.yaml
#   help
#
# Recursos AWS simulados en Floci (stack/aws/<proyecto>.yaml):
#   aws                 submenú        aws ls      ver recursos (mensajes, ítems, de qué archivo)
#   aws apply [arch…]   crea lo que falta de los archivos (sin argumentos: elegir)
#   aws new             crear uno con formulario y guardarlo en un archivo
#   aws rm              eliminar: elegidos, los de un archivo o todo
#   aws test            enviar/ver/consumir/purgar mensajes, publicar en SNS, ver ítems y valores
#
# API Gateway (stack/apigw/<proyecto>.yaml):
#   apigw               submenú        apigw ls    rutas publicadas y diferencias
#   apigw publish [arch…]  publica archivos completos (sin argumentos: elegir archivos o rutas)
#   apigw rm            quitar rutas sueltas, las de un archivo o todo   ·   apigw clear
#
# Proyecto: -p <nombre|ruta>, si no la carpeta actual (si tiene k8s/vars.yaml),
#           si no el último usado. Los proyectos se buscan en $DEV_PROJECTS (~/projects).
#
# Variables: CLUSTER (local) · DEV_PROJECTS · DEV_STACK (./stack) · FLOCI_URL · FLOCI_IP (172.18.0.10) · AWS_REGION
#            FLOCI_IMAGE · K3S_IMAGE (versión de k8s igual a tu EKS) · ROLLOUT_TIMEOUT (300s)
#            DRY_RUN=1 dev apigw  → muestra lo que haría sin tocar nada
#
# Seguridad: kubectl siempre usa --context k3d-$CLUSTER y aws siempre --endpoint-url
#            de Floci, aunque tu kubectl apunte a EKS o tengas credenciales reales.
#
# Requiere: docker, k3d, kubectl, yq (mikefarah ≥ 4.35), gum, aws, curl

setopt pipefail
zmodload zsh/datetime

SELF=${0:A}
DEV_HOME=${0:A:h}
STACK=${DEV_STACK:-$DEV_HOME/stack}          # infraestructura: aws/, apigw/, floci/
AWS_DIR=$STACK/aws                             # recursos AWS por proyecto
ROUTES_DIR=${ROUTES_DIR:-$STACK/apigw}         # rutas del API Gateway por proyecto
PROJECTS_DIR=${DEV_PROJECTS:-$HOME/projects}
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/dev
LOG=$CACHE/last.log

CLUSTER=${CLUSTER:-local}
NETWORK=${NETWORK:-aws-local}
SUBNET=172.18.0.0/16
IP_RANGE=172.18.128.0/17          # IPs dinámicas (k3d) lejos de las fijas (Floci = .10)
FLOCI_IP=${FLOCI_IP:-172.18.0.10}
FLOCI=${FLOCI_URL:-http://localhost:4566}
REGION=${AWS_REGION:-us-east-1}
API_ID_SET=$API_ID; API_ID=${API_ID:-local}
STAGE=${STAGE:-local}
DRY_RUN=${DRY_RUN:-0}
FLOCI_IMAGE=${FLOCI_IMAGE:-floci/floci:latest}
K3S_IMAGE=${K3S_IMAGE:-}                 # ej: rancher/k3s:v1.32.5-k3s1 (igual a la versión de tu EKS)
ROLLOUT_TIMEOUT=${ROLLOUT_TIMEOUT:-300s}

# Seguridad: todo kubectl va al clúster k3d y todo aws a Floci, sin importar el
# contexto actual de kubectl ni AWS_PROFILE/credenciales reales en el entorno.
KCTX=k3d-$CLUSTER
K=(kubectl --context $KCTX)
AWSL=(env -u AWS_PROFILE -u AWS_SESSION_TOKEN AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test AWS_PAGER=
      aws --endpoint-url $FLOCI --region $REGION --output text)   # AWS_PAGER vacío: el CLI v2 no abre less

mkdir -p $CACHE

# ---------------------------------------------------------------- estilos
(( $+commands[gum] )) && HAS_GUM=1 || HAS_GUM=0
_s()    { local fg=$1; shift; if (( HAS_GUM )); then gum style --foreground $fg "$*"; else print -r -- "$*"; fi }
ok()    { _s 42  "✔ $*" }
warn()  { _s 214 "! $*" }
err()   { _s 196 "✘ $*" >&2 }
dim()   { _s 245 "$*" }
title() { if (( HAS_GUM )); then gum style --bold --foreground 212 "$*"; else print -r -- "== $*"; fi }

# Ejecuta un comando con spinner; si falla, muestra las últimas líneas del log.
# Para funciones de este archivo usa: step "msg" $SELF <acción> ...
step() {
  local msg=$1; shift
  if gum spin --spinner dot --title "$msg..." -- zsh -c '"$@" >"$0" 2>&1' $LOG "$@"; then
    ok $msg
  else
    err "$msg falló:"
    [[ -s $LOG ]] && tail -n 25 $LOG | gum style --foreground 245 --padding "0 2"
    dim "Log completo: $LOG"
    return 1
  fi
}

check_tools() {
  local t; local -a missing
  for t in "$@"; do (( $+commands[$t] )) || missing+=$t; done
  (( $#missing == 0 )) || { err "Faltan herramientas: $missing"; exit 1 }
  [[ $(yq --version 2>/dev/null) == *mikefarah* ]] || { err "Necesito el yq de mikefarah (el de apt es otro programa)."; exit 1 }
}

# ---------------------------------------------------------------- proyectos
list_projects() { print -rl -- $PROJECTS_DIR/*/k8s/vars.yaml(N:h:h:t) }

# Lee el bloque local de k8s/vars.yaml
load_app() {
  local -a v
  v=("${(@f)$(yq '.local | (.appName // "", .namespace // "local", .containerPort // 8080,
                .repository // .appName // "", .imageTag // "local", .dockerfile // "Dockerfile",
                .gradleTask // "build -x test", .deploymentName // .appName + "-deploy")' $VARS)}")
  APP=$v[1] NS=$v[2] PORT=$v[3] IMAGE="$v[4]:$v[5]" DOCKERFILE=$v[6] GRADLE_TASK=$v[7]
  [[ -n $APP ]] || { err "Falta local.appName en $VARS"; return 1 }
  DEPLOY="deployment/$v[8]"
  # dockerBuildArgs: mapa {CLAVE: valor} o lista ["CLAVE=valor"]
  BUILD_ARGS=(${(f)"$(yq '.local.dockerBuildArgs // {} |
      ((select(tag == "!!map") | to_entries | .[] | .key + "=" + (.value | to_string)),
       (select(tag == "!!seq") | .[]))' $VARS)"})
  BUILD_ARGS=(${BUILD_ARGS/#/--build-arg=})
}

set_project() {  # $1 = nombre (en $PROJECTS_DIR) o ruta
  local p=$1
  [[ -d $p ]] || p=$PROJECTS_DIR/$1
  [[ -f $p/k8s/vars.yaml ]] || { err "No encontré k8s/vars.yaml en $p"; return 1 }
  PROJECT=${p:A} K8S=${p:A}/k8s VARS=${p:A}/k8s/vars.yaml
  print -r -- $PROJECT >$CACHE/last-project
  load_app
}

pick_project() {
  local -a names=($(list_projects))
  (( $#names )) || { err "No hay proyectos con k8s/vars.yaml en $PROJECTS_DIR"; return 1 }
  local sel
  sel=$(print -rl -- $names | gum filter --header "📦 Proyecto" --placeholder "buscar...") || return 1
  set_project $PROJECTS_DIR/$sel
}

resolve_project() {  # -p > carpeta actual > último usado
  if [[ -n $OPT_PROJECT ]]; then set_project $OPT_PROJECT; return
  elif [[ -f $PWD/k8s/vars.yaml ]]; then set_project $PWD
  elif [[ -f $CACHE/last-project && -f $(<$CACHE/last-project)/k8s/vars.yaml ]]; then
    set_project $(<$CACHE/last-project)
  fi
  return 0
}

need_project() { [[ -n $APP ]] || pick_project }

# Sin "| grep -q": con pipefail, grep -q corta la tubería (SIGPIPE) y da falso negativo
running_containers() { docker ps --format '{{.Names}}' 2>/dev/null }
cluster_running() { local -a n=(${(f)"$(running_containers)"}); (( ${n[(Ie)k3d-$CLUSTER-server-0]} )) }

# Clúster corriendo y su contexto presente (p. ej. si `aws eks update-kubeconfig`
# o alguien reescribió ~/.kube/config, se vuelve a fusionar sin tocar el contexto actual)
need_cluster() {
  cluster_running || { err "El clúster '$CLUSTER' no está encendido. Usa ⏻ Encender (dev on)."; return 1 }
  kubectl config get-contexts $KCTX >/dev/null 2>&1 && return 0
  step "Recuperando contexto $KCTX" k3d kubeconfig merge $CLUSTER --kubeconfig-merge-default --kubeconfig-switch-context=false
}

# Ejecuta sin spinner ni salida; solo habla si falla
quiet() {
  local msg=$1; shift
  "$@" >$LOG 2>&1 && return 0
  err "$msg falló:"; tail -n 15 $LOG | sed 's/^/  /' >&2
  return 1
}
floci_running()   { local -a n=(${(f)"$(running_containers)"}); (( ${n[(Ie)floci]} )) }

header() {
  local dk="🔴 Docker" cl="🔴 k3d" fl="🔴 Floci" app=""
  if docker_running; then
    dk="🟢 Docker"
    cluster_running && cl="🟢 k3d"
    floci_running   && fl="🟢 Floci"
  fi
  [[ -n $APP ]] && app="  ·  📦 $APP → ns $NS" || app="  ·  📦 (sin proyecto)"
  gum style --border rounded --border-foreground 212 --padding "0 2" --margin "1 0" \
    "$(title '☁  Ambiente local')" "$dk   $fl   $cl$app"
}

# ---------------------------------------------------------------- archivos embebidos
# compose de Floci: usa stack/floci/compose.yaml si existe, si no este por defecto
compose_file() {
  if [[ -f $STACK/floci/compose.yaml ]]; then print -r -- $STACK/floci/compose.yaml; return; fi
  cat >$CACHE/compose.yaml <<EOF
name: floci
services:
  floci:
    image: $FLOCI_IMAGE
    container_name: floci
    user: root
    restart: unless-stopped
    ports: ["4566:4566"]
    environment:
      FLOCI_DEFAULT_REGION: $REGION
      FLOCI_STORAGE_MODE: hybrid
      FLOCI_STORAGE_PERSISTENT_PATH: /data
      FLOCI_SERVICES_LAMBDA_DOCKER_NETWORK: $NETWORK
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - floci-data:/data
    networks:
      $NETWORK:
        ipv4_address: $FLOCI_IP
networks:
  $NETWORK:
    external: true
volumes:
  floci-data:
EOF
  print -r -- $CACHE/compose.yaml
}

# Service + EndpointSlice "floci" (DNS sin depender del DNS corporativo) y ConfigMap
# "aws-local" para envFrom. Se genera por namespace, así cualquier app ve a Floci.
floci_manifest() {  # $1 = namespace → imprime la ruta del archivo
  local f=$CACHE/floci-$1.yaml
  cat >$f <<EOF
apiVersion: v1
kind: Service
metadata:
  name: floci
  namespace: $1
  labels: {app.kubernetes.io/managed-by: dev-scripts}
spec:
  ports: [{name: http, port: 4566, targetPort: 4566, protocol: TCP}]
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: floci-1
  namespace: $1
  labels: {kubernetes.io/service-name: floci, app.kubernetes.io/managed-by: dev-scripts}
addressType: IPv4
ports: [{name: http, port: 4566, protocol: TCP}]
endpoints: [{addresses: ["$FLOCI_IP"]}]
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: aws-local
  namespace: $1
  labels: {app.kubernetes.io/managed-by: dev-scripts}
data:
  AWS_ENDPOINT_URL: http://floci:4566
  AWS_REGION: $REGION
  AWS_DEFAULT_REGION: $REGION
  AWS_ACCESS_KEY_ID: test
  AWS_SECRET_ACCESS_KEY: test
EOF
  print -r -- $f
}

ensure_namespace() {  # $1 = namespace: lo crea y le conecta Floci
  $K get namespace $1 >/dev/null 2>&1 || step "Creando namespace $1" $K create namespace $1 || return 1
  quiet "Conectar namespace $1 con Floci" $K apply -f $(floci_manifest $1)
}

# ---------------------------------------------------------------- render (antes render.sh)
# Reemplaza $(variable) en las plantillas de k8s/, igual que el pipeline de Azure DevOps.
cmd_render() {  # $1 dir_k8s  $2 ambiente  $3 salida
  local src=${1:-$K8S}
  [[ -n $src ]] || { err "Uso: dev render <dir_k8s> [ambiente] [dir_salida]"; return 1 }
  src=${src:A}
  local env=${2:-local}
  local out=${3:-${src:h}/.rendered/$env}
  local vars=$src/vars.yaml
  [[ -f $vars ]] || { err "No encontré $vars"; return 1 }

  # Aplana el bloque del ambiente en clave=valor (anidados con punto: limits.memory)
  local -a pairs
  pairs=(${(f)"$(yq ".\"$env\" // {}" $vars |
    yq '.. | select(tag != "!!map" and tag != "!!seq") | (path | join(".")) + "=" + (. | to_string)')"})
  (( $#pairs )) || { err "No encontré el bloque '$env' en $vars"; return 1 }

  mkdir -p $out && rm -f $out/*.yaml(N)
  local f p k v content pend=0
  for f in $src/*.yaml(N); do
    [[ ${f:t} == vars.yaml ]] && continue
    content=$(<$f)
    for p in $pairs; do
      k=${p%%=*} v=${p#*=}
      content=${content//"\$($k)"/$v}
    done
    print -r -- $content >$out/${f:t}
    if grep -qE '\$\([A-Za-z0-9_.]+\)' $out/${f:t}; then
      err "Variables sin valor en ${f:t}:"
      grep -noE '\$\([A-Za-z0-9_.]+\)' $out/${f:t} | sed 's/^/   /' >&2
      pend=1
    fi
  done
  (( pend )) && { err "Agrega las variables faltantes al bloque '$env' de $vars"; return 1 }
  ok "Plantillas renderizadas en $out"
}

# ---------------------------------------------------------------- encender / apagar
docker_running() { docker info >/dev/null 2>&1 }
floci_up()       { curl -s -o /dev/null --max-time 3 $FLOCI }

start_docker() {
  docker_running && return 0
  sudo -v || return 1   # pide la contraseña antes del spinner
  local -a cmd=(sudo service docker start)
  [[ $(ps -p 1 -o comm= 2>/dev/null) == systemd ]] && cmd=(sudo systemctl start docker)
  step "Iniciando Docker" $cmd || return 1
  step "Esperando al daemon de Docker" zsh -c 'for i in {1..30}; do docker info >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1'
}

start_floci() {
  local subnet
  if subnet=$(docker network inspect $NETWORK -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}' 2>/dev/null); then
    [[ $subnet == $SUBNET ]] || {
      err "La red $NETWORK existe con subnet $subnet (se esperaba $SUBNET): Floci no podrá usar $FLOCI_IP."
      dim "Elimínala con 'docker network rm $NETWORK' (primero 'dev destroy') y vuelve a encender."
      return 1 }
  else
    step "Creando red $NETWORK" docker network create --subnet $SUBNET --ip-range $IP_RANGE \
      --gateway 172.18.0.1 $NETWORK || return 1
  fi
  step "Encendiendo Floci" docker compose -f $(compose_file) up -d || return 1
  step "Esperando a Floci" zsh -c 'for i in {1..30}; do curl -s -o /dev/null --max-time 2 "$0" && exit 0; sleep 1; done; exit 1' $FLOCI
}

start_k3d() {
  if k3d cluster list $CLUSTER >/dev/null 2>&1; then
    cluster_running || step "Encendiendo clúster $CLUSTER" k3d cluster start $CLUSTER || return 1
  else
    step "Creando clúster $CLUSTER" k3d cluster create $CLUSTER --network $NETWORK \
      ${K3S_IMAGE:+--image=$K3S_IMAGE} --k3s-arg "--disable=traefik@server:*" \
      --kubeconfig-switch-context=false --wait || return 1
  fi
  need_cluster || return 1
  local cur=$(kubectl config current-context 2>/dev/null)
  if [[ $cur != $KCTX ]]; then
    gum confirm --default=false "Tu kubectl apunta a '${cur:-ninguno}'. ¿Cambiarlo a $KCTX (para k9s/kubectl manual)?" \
      && kubectl config use-context $KCTX >/dev/null && ok "kubectl → $KCTX"
  fi
  ensure_namespace local
}

stop_k3d()   { cluster_running && step "Apagando clúster $CLUSTER" k3d cluster stop $CLUSTER || dim "  k3d ya estaba apagado" }
stop_floci() { floci_running && step "Apagando Floci" docker compose -f $(compose_file) stop || dim "  Floci ya estaba apagado" }
stop_docker() {
  docker_running || { dim "  Docker ya estaba apagado"; return 0 }
  sudo -v || return 1
  local -a cmd=(sudo service docker stop)
  [[ $(ps -p 1 -o comm= 2>/dev/null) == systemd ]] && cmd=(sudo systemctl stop docker docker.socket)
  step "Apagando Docker" $cmd
}

# dev on [all|floci|k3d] — enciende Docker si hace falta y luego lo pedido
cmd_on() {
  local what=${1:-all}
  [[ $what == (all|floci|k3d) ]] || { err "Uso: dev on [all|floci|k3d]"; return 1 }
  title "Encendiendo ${what/all/todo}"
  start_docker || return 1
  [[ $what == (all|floci) ]] && { start_floci || return 1 }
  [[ $what == (all|k3d) ]]   && { start_k3d || return 1 }
  ok "Listo · Floci: $FLOCI · Floci UI: http://localhost:4500"
  # Floci recién creado o sin datos persistentes: ofrecer crear lo declarado en stack/aws
  if [[ $what == (all|floci) && -n $(aws_files) ]] && floci_empty; then
    gum confirm "Floci no tiene recursos. ¿Crear los de stack/aws/?" && aws_apply $(aws_files)
  fi
  return 0
}

# dev off [all|floci|k3d|docker] — sin argumento pregunta. 'docker' apaga todo y libera memoria de WSL
cmd_off() {
  local what=$1
  if [[ -z $what ]]; then
    what=$(gum choose --header "⏻ ¿Qué apagar? (se conserva todo, solo se detiene)" \
      "Todo (k3d + Floci)" "Solo k3d" "Solo Floci" "Todo + Docker (libera la memoria de WSL)" "Cancelar") || return 0
    case $what in Todo\ \(*) what=all ;; Solo\ k3d) what=k3d ;; Solo\ Floci) what=floci ;; Todo\ +*) what=docker ;; *) return 0 ;; esac
  fi
  [[ $what == (all|floci|k3d|docker) ]] || { err "Uso: dev off [all|floci|k3d|docker]"; return 1 }
  docker_running || { ok "Docker ya está apagado (y con él todo)"; return 0 }
  title "Apagando ${${what/all/todo}/docker/todo + Docker}"
  [[ $what == (all|k3d|docker) ]]   && stop_k3d
  [[ $what == (all|floci|docker) ]] && stop_floci
  [[ $what == docker ]] && stop_docker
  return 0
}

# Interruptor del menú: según lo que esté encendido ofrece lo que tiene sentido
cmd_power() {
  local d=0 f=0 k=0
  docker_running && { d=1; floci_running && f=1; cluster_running && k=1 }
  print -r -- "  Docker $( ((d)) && print 🟢 || print 🔴)   Floci $( ((f)) && print 🟢 || print 🔴)   k3d $( ((k)) && print 🟢 || print 🔴)"
  local -a opts=()
  (( f && k )) || opts+="⏻ Encender todo"
  (( f )) || opts+="⏻ Encender solo Floci"
  (( k )) || opts+="⏻ Encender solo k3d"
  (( f || k )) && opts+="⏼ Apagar…"
  (( d && !f && !k )) && opts+="⏼ Apagar Docker (libera la memoria de WSL)"
  local c; c=$(gum choose --header "Encender / apagar" $opts "Cancelar") || return 0
  case $c in
    *"Encender todo")  cmd_on all ;;
    *"solo Floci")     cmd_on floci ;;
    *"solo k3d")       cmd_on k3d ;;
    *"Apagar…")        cmd_off ;;
    *"Apagar Docker"*) title "Apagando Docker"; stop_docker ;;
  esac
}

cmd_up()    { cmd_on "$@" }        # nombres anteriores
cmd_pause() { cmd_off all }

# ---------------------------------------------------------------- acciones
deploy() {   # $1 = build | nobuild
  need_project || return 1
  need_cluster || return 1
  title "Desplegando $APP"
  local t0=$EPOCHSECONDS

  if [[ $1 == build ]]; then
    if [[ -x $PROJECT/gradlew && -n $GRADLE_TASK && $GRADLE_TASK != false ]]; then
      step "Compilando con Gradle ($GRADLE_TASK)" $PROJECT/gradlew -p $PROJECT ${=GRADLE_TASK} || return 1
    fi
    (( $#BUILD_ARGS )) && dim "  build args: ${(j:  ·  :)${BUILD_ARGS#--build-arg=}}"
    step "Construyendo imagen $IMAGE" docker build -f $PROJECT/$DOCKERFILE $BUILD_ARGS -t $IMAGE $PROJECT || return 1
    step "Importando imagen a k3d" k3d image import $IMAGE -c $CLUSTER || return 1
  fi

  local out=$PROJECT/.rendered/local
  step "Rellenando plantillas de k8s/" $SELF render $K8S local $out || return 1

  # Marca de tiempo en el pod template: cada apply produce UN rollout que toma la
  # imagen nueva y los cambios de ConfigMap/Secret (sin un restart aparte).
  NOW=$(strftime %Y-%m-%dT%H:%M:%S $EPOCHSECONDS) \
    yq -i '(select(.kind == "Deployment") | .spec.template.metadata.annotations."dev-scripts/restarted-at") = strenv(NOW)' \
    $out/*.yaml(N)
  if [[ $(yq 'select(.kind == "Deployment") | .spec.template.spec.containers[].imagePullPolicy' $out/*.yaml(N)) == *Always* ]]; then
    warn "imagePullPolicy: Always en local → k3d intentará bajar $IMAGE de un registry. Usa IfNotPresent."
  fi
  # El nombre real del Deployment sale de los manifiestos (no depende de la convención <app>-deploy)
  local dname=$(yq 'select(.kind == "Deployment") | .metadata.name' $out/*.yaml(N) | grep -v -- '---' | head -1)
  [[ -n $dname ]] && DEPLOY=deployment/$dname

  ensure_namespace $NS || return 1
  step "Aplicando manifiestos" $K apply -f $out || return 1
  grep -v unchanged $LOG | sed 's/^/  /'

  if step "Esperando a que el pod quede listo" $K rollout status $DEPLOY -n $NS --timeout=$ROLLOUT_TIMEOUT; then
    ok "$APP desplegado en $(( EPOCHSECONDS - t0 ))s"
  else
    diagnose
    return 1
  fi
}

# Por qué no arranca: estado de cada pod, motivo (CrashLoopBackOff, ImagePull, OOMKilled,
# probes...), eventos recientes y logs del intento anterior si el contenedor se reinició.
diagnose() {
  title "Diagnóstico de $APP"
  $K get pods -n $NS -l app=$APP -o wide
  echo
  local pod reason restarts
  for pod in ${(f)"$($K get pods -n $NS -l app=$APP -o name 2>/dev/null)"}; do
    reason=$($K get $pod -n $NS -o jsonpath='{range .status.containerStatuses[*]}{.state.waiting.reason}{.state.terminated.reason} {.lastState.terminated.reason} (exit {.lastState.terminated.exitCode}){end}')
    reason=${${reason// \(exit \)/}%% }
    restarts=$($K get $pod -n $NS -o jsonpath='{.status.containerStatuses[0].restartCount}')
    print -r -- "  ${pod#pod/}: ${reason:-sin motivo reportado} · reinicios: ${restarts:-0}"
    case $reason in
      *ErrImage*|*ImagePull*) dim "    → imagen no encontrada en k3d: ¿corriste 'deploy' (no 'apply')? ¿coincide $IMAGE?" ;;
      *OOMKilled*)            dim "    → sin memoria: sube resources.limits.memory o baja -Xmx" ;;
      *CreateContainerConfig*) dim "    → falta un ConfigMap/Secret referenciado (envFrom, volumes)" ;;
    esac
  done
  echo
  gum style --bold "Eventos"
  $K get events -n $NS --sort-by=.lastTimestamp --field-selector type=Warning 2>/dev/null | tail -n 8 | sed 's/^/  /'
  echo
  if (( ${restarts:-0} > 0 )) && gum confirm "¿Ver logs del intento anterior (el que falló)?"; then
    $K logs -n $NS ${pod} --previous --tail=120
  elif gum confirm "¿Ver los logs del pod?"; then
    $K logs -n $NS -l app=$APP --all-containers --prefix --tail=80
  fi
}
