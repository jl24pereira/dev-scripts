# ================================================================ recursos en Floci (stack/aws/*.yaml)
# Un archivo por proyecto declara lo que necesita. Aplicarlo crea solo lo que falta.
# Solo para Floci: awsx() siempre usa el endpoint de Floci con credenciales de prueba.
# Los recursos de las cuentas reales se despliegan con CloudFormation (su propio repo/pipeline).
#
#   sqs:
#     - name: pagos-eventos
#       dlq: {maxReceiveCount: 3}      # o dlq: true → crea pagos-eventos-dlq y la enlaza
#       visibilityTimeout: 30
#     - pagos-cmd.fifo                  # forma corta: solo el nombre (.fifo → cola FIFO)
#   sns:
#     - name: pagos-topic
#       subscriptions: [{protocol: sqs, endpoint: pagos-eventos, raw: true}]
#   dynamodb:
#     - name: pagos
#       key: {pk: S, sk: S}             # la 1ª es HASH, la 2ª RANGE · S | N | B
#       gsi: [{name: por-estado, key: {estado: S}}]
#       items: [{pk: "1", sk: "a", monto: 10}]   # semilla, solo al crear la tabla
#   s3: [pagos-docs]
#   secrets: [{name: pagos/db, value: {user: app, pass: ${DB_PASS}}}]  # ${VAR} del entorno
#   ssm:     [{name: /pagos/url, value: http://x, type: String}]

FLOCI_LABEL="Floci ($FLOCI)"
AWS_TYPES=(sqs sns dynamodb s3 secrets ssm)
typeset -A AWS_TYPE_LABEL=(sqs "SQS" sns "SNS" dynamodb "DynamoDB" s3 "S3" secrets "Secrets Manager" ssm "SSM Parameter Store")
NORM='((select(tag == "!!str") | {"name": .}) // .)'

awsx()  { $AWSL "$@" }
awsjx() { $AWSL --output json "$@" }

need_floci() {
  floci_up && return 0
  err "Floci no responde en $FLOCI. Usa ⏻ Encender (dev on floci)."; return 1
}

# Reemplaza ${VAR} por su valor del entorno (resultado en REPLY). Falla si VAR no existe.
expand_env() {
  local s=$1 out="" name
  while [[ $s =~ '\$\{([A-Za-z_][A-Za-z0-9_]*)\}' ]]; do
    name=$match[1]
    (( ${+parameters[$name]} )) || { err "La variable de entorno $name no está definida"; return 1 }
    out+=${s[1,MBEGIN-1]}${(P)name}
    s=${s[MEND+1,-1]}
  done
  REPLY=$out$s
}

nonone() { tr '\t' '\n' | sed '/^None$/d; /^null$/d; /^$/d' }
jv() { yq -p=json -o=yaml "$1" <<<"$J" }     # campo del recurso en $J (JSON)

res() {  # estado tipo nombre [detalle]
  case $1 in
    new)  gum style --foreground 42  "  + ${(r:9:)2} $3${4:+   $4}" ;;
    same) gum style --foreground 245 "  = ${(r:9:)2} $3${4:+   $4}" ;;
    del)  gum style --foreground 214 "  - ${(r:9:)2} $3" ;;
    fail) gum style --foreground 196 "  ✘ ${(r:9:)2} $3: ${4##*$'\n'}" ;;
  esac
}

aws_files() { print -rl -- $AWS_DIR/*.yaml(N) }

pick_aws_files() {  # multi-selección → rutas (preselecciona el del proyecto actual)
  local -a f=(${(f)"$(aws_files)"})
  (( $#f )) || { err "No hay archivos en ${AWS_DIR/#$HOME/~} (crea uno con 'Crear recurso' → Guardar)"; return 1 }
  local sel
  sel=$(gum choose --no-limit --header "📄 Archivos de stack/aws (espacio marca)" \
        ${APP:+--selected=$APP} ${f:t:r}) || return 1
  [[ -n $sel ]] || return 1
  print -rl -- $AWS_DIR/${^${(f)sel}}.yaml
}

# ---- nombres e identificadores
queue_url() { awsx sqs get-queue-url --queue-name $1 --query QueueUrl 2>/dev/null }
queue_arn() { awsx sqs get-queue-attributes --queue-url $(queue_url $1) --attribute-names QueueArn --query Attributes.QueueArn }
topic_arn() { awsx sns list-topics --query 'Topics[].TopicArn' 2>/dev/null | nonone | grep -E ":$1\$" | head -1 }
dlq_name()  { [[ $1 == *.fifo ]] && print -r -- ${1%.fifo}-dlq.fifo || print -r -- $1-dlq }

# JSON {"k":"v",...} desde un array asociativo (valores siempre string, como pide SQS)
assoc_json() {
  local -A a=("${(@Pkv)1}"); local k v out=""
  for k v in ${(kv)a}; do v=${v//\\/\\\\}; v=${v//\"/\\\"}; out+="${out:+,}\"$k\":\"$v\""; done
  print -r -- "{$out}"
}

# ---- aplicar un recurso (J = JSON del recurso normalizado)
apply_sqs() {
  local J=$1 name dlqk dlqv mrc vt dlq="" out
  name=$(jv .name) dlqk=$(jv '.dlq | tag') dlqv=$(jv '.dlq') mrc=$(jv '.dlq.maxReceiveCount // 3') vt=$(jv '.visibilityTimeout // ""')
  [[ -n $name && $name != null ]] || { res fail sqs "?" "falta name"; return 1 }
  if [[ $dlqk == '!!map' || $dlqv == true ]]; then
    dlq=$(dlq_name $name)
    ensure_queue $dlq || return 1
  fi
  ensure_queue $name "$vt" "$dlq" "$mrc"
}

ensure_queue() {  # nombre [visibilityTimeout] [dlq] [maxReceiveCount]
  local name=$1 vt=$2 dlq=$3 mrc=$4 url out
  local -A at=()
  [[ -n $vt ]] && at[VisibilityTimeout]=$vt
  [[ -n $dlq ]] && at[RedrivePolicy]="{\"deadLetterTargetArn\":\"$(queue_arn $dlq)\",\"maxReceiveCount\":\"$mrc\"}"
  if url=$(queue_url $name); then
    (( $#at )) && awsx sqs set-queue-attributes --queue-url $url --attributes "$(assoc_json at)" >/dev/null 2>&1
    res same sqs $name "${dlq:+→ $dlq}"
    return 0
  fi
  [[ $name == *.fifo ]] && at[FifoQueue]=true
  local -a attrarg=()
  (( $#at )) && attrarg=(--attributes "$(assoc_json at)")
  if out=$(awsx sqs create-queue --queue-name $name $attrarg 2>&1); then
    res new sqs $name "${dlq:+→ DLQ $dlq (maxReceiveCount $mrc)}"
  else
    res fail sqs $name "$out"; return 1
  fi
}

apply_sns() {
  local J=$1 name arn out i n p ep raw had
  name=$(jv .name)
  had=$(topic_arn $name)
  arn=$(awsx sns create-topic --name $name --query TopicArn 2>&1) || { res fail sns $name "$arn"; return 1 }
  [[ -n $had ]] && res same sns $name || res new sns $name
  n=$(jv '(.subscriptions // []) | length')
  local -a existing=(${(f)"$(awsx sns list-subscriptions-by-topic --topic-arn $arn --query 'Subscriptions[].Endpoint' 2>/dev/null | nonone)"})
  for (( i=0; i<n; i++ )); do
    p=$(jv ".subscriptions[$i].protocol // \"sqs\"") ep=$(jv ".subscriptions[$i].endpoint") raw=$(jv ".subscriptions[$i].raw // false")
    [[ $p == sqs && $ep != arn:* ]] && { ep=$(queue_arn $ep) || { res fail sns "$name" "la cola $(jv ".subscriptions[$i].endpoint") no existe"; continue } }
    if (( ${existing[(Ie)$ep]} )); then res same "  └ sub" "$p → ${ep##*:}"; continue; fi
    if out=$(awsx sns subscribe --topic-arn $arn --protocol $p --notification-endpoint $ep \
             ${${(M)raw:#true}:+--attributes} ${${(M)raw:#true}:+RawMessageDelivery=true} 2>&1); then
      res new "  └ sub" "$p → ${ep##*:}${${(M)raw:#true}:+ (raw)}"
    else res fail "  └ sub" "${ep##*:}" "$out"
    fi
  done
}

apply_dynamodb() {
  local J=$1 name input out n i item
  name=$(jv .name)
  if awsx dynamodb describe-table --table-name $name >/dev/null 2>&1; then res same dynamodb $name; return 0; fi
  input=$(yq -p=json -o=json -I=0 '{
      "TableName": .name, "BillingMode": "PAY_PER_REQUEST",
      "KeySchema": (.key | to_entries | to_entries | map({"AttributeName": .value.key, "KeyType": (if .key == 0 then "HASH" else "RANGE" end)})),
      "AttributeDefinitions": (([.key] + ((.gsi // []) | map(.key))) | map(to_entries) | flatten | unique_by(.key) | map({"AttributeName": .key, "AttributeType": .value})),
      "GlobalSecondaryIndexes": ((.gsi // []) | map({"IndexName": .name,
          "KeySchema": (.key | to_entries | to_entries | map({"AttributeName": .value.key, "KeyType": (if .key == 0 then "HASH" else "RANGE" end)})),
          "Projection": {"ProjectionType": "ALL"}}))
    } | with(select(.GlobalSecondaryIndexes | length == 0); del(.GlobalSecondaryIndexes))' <<<"$J" 2>&1) \
    || { res fail dynamodb $name "definición inválida (¿falta key?): $input"; return 1 }
  out=$(awsx dynamodb create-table --cli-input-json "$input" 2>&1) || { res fail dynamodb $name "$out"; return 1 }
  awsx dynamodb wait table-exists --table-name $name 2>/dev/null
  n=$(jv '(.items // []) | length')
  for (( i=0; i<n; i++ )); do   # semilla: valores simples → tipos de DynamoDB
    item=$(yq -p=json -o=json -I=0 ".items[$i] | with_entries(.value |= (
        (select(tag == \"!!str\") | {\"S\": .}) // (select(tag == \"!!int\" or tag == \"!!float\") | {\"N\": to_string})
        // (select(tag == \"!!bool\") | {\"BOOL\": .}) // {\"S\": (. | @json)}))" <<<"$J")
    awsx dynamodb put-item --table-name $name --item "$item" >/dev/null 2>&1 || res fail dynamodb "$name" "ítem $((i+1)) no se pudo insertar"
  done
  res new dynamodb $name "key: $(jv '.key | to_entries | map(.key + ":" + .value) | join(", ")')${${(M)n:#<1->}:+ · $n ítems}"
}

apply_s3() {
  local J=$1 name out
  name=$(jv .name)
  if awsx s3api head-bucket --bucket $name >/dev/null 2>&1; then res same s3 $name; return 0; fi
  local -a loc=()
  [[ $REGION != us-east-1 ]] && loc=(--create-bucket-configuration LocationConstraint=$REGION)
  out=$(awsx s3api create-bucket --bucket $name $loc 2>&1) && res new s3 $name || { res fail s3 $name "$out"; return 1 }
}

apply_secrets() {
  local J=$1 name val out input
  name=$(jv .name)
  if awsx secretsmanager describe-secret --secret-id $name >/dev/null 2>&1; then res same secret $name; return 0; fi
  val=$(yq -p=json -o=yaml '(.value | select(tag == "!!map" or tag == "!!seq") | @json) // (.value // "" | to_string)' <<<"$J")
  expand_env "$val" || { res fail secret $name "variable de entorno faltante"; return 1 }
  input=$(N=$name V=$REPLY yq -n -o=json -I=0 '.Name = strenv(N) | .SecretString = strenv(V)')
  out=$(awsx secretsmanager create-secret --cli-input-json "$input" 2>&1) && res new secret $name || { res fail secret $name "$out"; return 1 }
}

apply_ssm() {
  local J=$1 name out input
  name=$(jv .name)
  if awsx ssm get-parameter --name $name >/dev/null 2>&1; then res same ssm $name; return 0; fi
  expand_env "$(jv '.value // "" | to_string')" || { res fail ssm $name "variable de entorno faltante"; return 1 }
  input=$(N=$name V=$REPLY T=$(jv '.type // "String"') yq -n -o=json -I=0 '.Name = strenv(N) | .Value = strenv(V) | .Type = strenv(T)')
  out=$(awsx ssm put-parameter --cli-input-json "$input" 2>&1) && res new ssm $name "($(jv '.type // "String"'))" || { res fail ssm $name "$out"; return 1 }
}

# Aplica uno o varios archivos: crea lo que falta, deja lo que existe
aws_apply() {
  need_floci || return 1
  local f t i n J fails=0
  local -a unknown
  for f in "$@"; do
    [[ -f $f ]] || f=$AWS_DIR/${f%.yaml}.yaml
    [[ -f $f ]] || { err "No existe $f"; fails=1; continue }
    title "📄 ${f:t}"
    yq '.' $f >/dev/null 2>&1 || { err "${f:t}: YAML inválido"; fails=1; continue }
    unknown=(${(f)"$(yq 'keys | .[]' $f 2>/dev/null)"}); unknown=(${unknown:|AWS_TYPES})
    (( $#unknown )) && warn "Claves no reconocidas en ${f:t}: ${(j:, :)unknown} (válidas: ${(j:, :)AWS_TYPES})"
    for t in $AWS_TYPES; do
      n=$(yq "(.$t // []) | length" $f)
      for (( i=0; i<n; i++ )); do
        J=$(yq -o=json -I=0 "(.$t // [])[$i] | $NORM" $f)
        apply_$t "$J" || fails=1
      done
    done
  done
  dim "  + creado   = ya existía (no se modifica)"
  return $fails
}

# ---- inventario: líneas "tipo<TAB>nombre<TAB>id" (id = URL de cola / ARN de tópico / nombre)
aws_inventory() {
  local x
  for x in ${(f)"$(awsx sqs list-queues --query 'QueueUrls[]' 2>/dev/null | nonone)"}; do print -r -- "sqs	${x##*/}	$x"; done
  for x in ${(f)"$(awsx sns list-topics --query 'Topics[].TopicArn' 2>/dev/null | nonone)"}; do print -r -- "sns	${x##*:}	$x"; done
  for x in ${(f)"$(awsx dynamodb list-tables --query 'TableNames[]' 2>/dev/null | nonone)"}; do print -r -- "dynamodb	$x	$x"; done
  for x in ${(f)"$(awsx s3api list-buckets --query 'Buckets[].Name' 2>/dev/null | nonone)"}; do print -r -- "s3	$x	$x"; done
  for x in ${(f)"$(awsx secretsmanager list-secrets --query 'SecretList[].Name' 2>/dev/null | nonone)"}; do print -r -- "secrets	$x	$x"; done
  for x in ${(f)"$(awsx ssm describe-parameters --query 'Parameters[].Name' 2>/dev/null | nonone)"}; do print -r -- "ssm	$x	$x"; done
}
floci_empty() { floci_up && [[ -z $(aws_inventory) ]] }

# DECL[tipo:nombre] = archivo que lo declara (incluye las DLQ implícitas)
typeset -gA DECL
declared_index() {
  DECL=()
  local f t line name dlq
  for f in ${(f)"$(aws_files)"}; do
    for t in $AWS_TYPES; do
      for line in ${(f)"$(yq "(.$t // [])[] | $NORM | .name + \"	\" + ((.dlq // false) | tag) + ((.dlq // false) | to_string)" $f 2>/dev/null)"}; do
        name=${line%%	*} dlq=${line#*	}
        DECL[$t:$name]=${f:t:r}
        [[ $t == sqs && ( $dlq == '!!map'* || $dlq == *true ) ]] && DECL[sqs:$(dlq_name $name)]=${f:t:r}
      done
    done
  done
}

# ---- ver
cmd_aws_ls() {
  need_floci || return 1
  declared_index
  local -a inv=(${(f)"$(aws_inventory)"})
  local -A have
  local t name id l a vis fly rp dl cnt
  for l in $inv; do have[${l%%	*}:${${l#*	}%%	*}]=1; done
  title "☁  Recursos AWS en $FLOCI_LABEL"
  (( $#inv )) || dim "  (no hay recursos)"
  for t in $AWS_TYPES; do
    local -a rows=(${(M)inv:#$t	*})
    (( $#rows )) || continue
    echo; gum style --bold "${AWS_TYPE_LABEL[$t]} ($#rows)"
    for l in $rows; do
      name=${${l#*	}%%	*} id=${l##*	}
      local src="📄 ${DECL[$t:$name]:-— sin archivo}"
      case $t in
        sqs)
          a=(${(s:	:)"$(awsx sqs get-queue-attributes --queue-url $id --attribute-names ApproximateNumberOfMessages ApproximateNumberOfMessagesNotVisible RedrivePolicy \
                --query 'Attributes.[ApproximateNumberOfMessages,ApproximateNumberOfMessagesNotVisible,RedrivePolicy]' 2>/dev/null)"})
          vis=${a[1]:-?} fly=${a[2]:-?} rp=${a[3]} dl=""
          [[ $rp =~ 'deadLetterTargetArn"[^"]*"[^"]*:([^:"]+)"' ]] && dl="→ DLQ $match[1]"
          printf '  %-38s %5s msgs  %4s en vuelo  %-28s %s\n' $name $vis $fly "$dl" "$src" ;;
        sns)
          cnt=$(awsx sns list-subscriptions-by-topic --topic-arn $id --query 'length(Subscriptions)' 2>/dev/null)
          printf '  %-38s %5s suscripciones                         %s\n' $name ${cnt:-0} "$src" ;;
        dynamodb)
          cnt=$(awsx dynamodb scan --table-name $name --select COUNT --query Count 2>/dev/null)
          printf '  %-38s %5s ítems                                 %s\n' $name ${cnt:-?} "$src" ;;
        s3)
          cnt=$(awsx s3api list-objects-v2 --bucket $name --query 'KeyCount' 2>/dev/null)
          [[ $cnt == (None|null) ]] && cnt=0
          printf '  %-38s %5s objetos                               %s\n' $name ${cnt:-0} "$src" ;;
        *)
          printf '  %-38s %-44s %s\n' $name "" "$src" ;;
      esac
    done
  done
  # declarados en stack/aws pero que no existen
  local -a missing=()
  for l in ${(k)DECL}; do (( ${+have[$l]} )) || missing+="${l%%:*} ${l#*:} (📄 ${DECL[$l]})"; done
  if (( $#missing )); then
    echo; warn "Declarados en stack/aws pero no creados:"
    print -rl -- "    "${^${(o)missing}}
    dim "  Créalos con: dev aws apply"
  fi
  echo; dim "Vista web: http://localhost:4500"
}

# ---- crear desde archivos
cmd_aws_apply() {
  local -a files=("$@")
  if (( ! $#files )); then
    [[ -t 0 ]] && files=(${(f)"$(pick_aws_files)"}) || files=(${(f)"$(aws_files)"})
  fi
  (( $#files )) || return 0
  aws_apply $files
}

# ---- crear interactivo: arma el mismo YAML que un archivo, lo aplica y ofrece guardarlo
cmd_aws_new() {
  need_floci || return 1
  local t c name J
  c=$(gum choose --header "➕ ¿Qué recurso?" "SQS · cola" "SNS · tópico" "DynamoDB · tabla" "S3 · bucket" \
      "Secrets Manager · secreto" "SSM · parámetro") || return 0
  case $c in SQS*) t=sqs ;; SNS*) t=sns ;; Dynamo*) t=dynamodb ;; S3*) t=s3 ;; Secrets*) t=secrets ;; SSM*) t=ssm ;; esac
  name=$(gum input --header "Nombre" --placeholder "${APP:-mi-app}-…") || return 0
  [[ -n $name ]] || return 0
  J=$(N=$name yq -n -o=json -I=0 '.name = strenv(N)')
  case $t in
    sqs)
      gum confirm --default=false "¿Cola FIFO?" && [[ $name != *.fifo ]] && { name+=.fifo; J=$(N=$name yq -n -o=json -I=0 '.name = strenv(N)') }
      if gum confirm "¿Con DLQ (cola de mensajes fallidos)?"; then
        local m; m=$(gum input --header "maxReceiveCount (intentos antes de ir a la DLQ)" --value 3) || return 0
        J=$(M=$m yq -p=json -o=json -I=0 '.dlq.maxReceiveCount = (strenv(M) | to_number)' <<<"$J")
      fi
      local v; v=$(gum input --header "visibilityTimeout (segundos)" --value 30) || return 0
      [[ $v != 30 && -n $v ]] && J=$(V=$v yq -p=json -o=json -I=0 '.visibilityTimeout = (strenv(V) | to_number)' <<<"$J") ;;
    sns)
      local -a qs=(${(f)"$(awsx sqs list-queues --query 'QueueUrls[]' 2>/dev/null | nonone)"}) sel
      if (( $#qs )); then
        sel=(${(f)"$(gum choose --no-limit --header "Suscribir colas (opcional, espacio marca)" ${qs##*/})"})
        local q; for q in $sel; do
          J=$(Q=$q yq -p=json -o=json -I=0 '.subscriptions += [{"protocol": "sqs", "endpoint": strenv(Q)}]' <<<"$J")
        done
      fi ;;
    dynamodb)
      local pk pt sk st
      pk=$(gum input --header "Partition key (nombre)" --value pk) || return 0
      pt=$(gum choose --header "Tipo de $pk" S N B) || return 0
      J=$(K=$pk T=$pt yq -p=json -o=json -I=0 '.key[strenv(K)] = strenv(T)' <<<"$J")
      sk=$(gum input --header "Sort key (vacío = sin sort key)" --placeholder sk) || return 0
      if [[ -n $sk ]]; then
        st=$(gum choose --header "Tipo de $sk" S N B) || return 0
        J=$(K=$sk T=$st yq -p=json -o=json -I=0 '.key[strenv(K)] = strenv(T)' <<<"$J")
      fi ;;
    secrets)
      local val; val=$(gum write --header "Valor (texto o JSON · \${VAR} se toma del entorno · Ctrl+D termina)" --height 6) || return 0
      J=$(V=$val yq -p=json -o=json -I=0 '.value = strenv(V)' <<<"$J") ;;
    ssm)
      local val ty; val=$(gum input --header "Valor" --width 80) || return 0
      ty=$(gum choose --header "Tipo" String SecureString StringList) || return 0
      J=$(V=$val T=$ty yq -p=json -o=json -I=0 '.value = strenv(V) | .type = strenv(T)' <<<"$J") ;;
  esac

  echo; gum style --foreground 245 "$t:" "$(yq -p=json -o=yaml <<<"[$J]" | sed 's/^/  /')"
  gum confirm "¿Crear?" || return 0
  apply_$t "$J" || return 1

  # Guardar en un archivo para que sea reproducible
  local -a files=(${(f)"$(aws_files)"}) opts; local dest def=${APP:-}
  opts=(${files:t:r})
  [[ -n $def ]] && (( ! ${opts[(Ie)$def]} )) && opts+="Nuevo: $def.yaml"
  opts+=("Nuevo archivo…" "No guardar")
  dest=$(gum choose --header "💾 ¿Guardarlo en stack/aws/? (así se recrea desde el archivo)" \
         ${def:+--selected=${${(M)opts:#$def}:-Nuevo: $def.yaml}} $opts) || return 0
  case $dest in
    "No guardar") dim "  Solo existe en Floci: no se recreará desde los archivos."; return 0 ;;
    "Nuevo archivo…") dest=$(gum input --header "Nombre del archivo (sin .yaml)" --value "$def") || return 0 ;;
    Nuevo:*) dest=${${dest#Nuevo: }%.yaml} ;;
  esac
  [[ -n $dest ]] || return 0
  local f=$AWS_DIR/$dest.yaml
  mkdir -p $AWS_DIR; [[ -f $f ]] || print "# Recursos AWS de $dest (dev aws apply)" >$f
  T=$t J=$J yq -i '.[strenv(T)] = ((.[strenv(T)] // []) + [strenv(J) | @jsond]) | .[strenv(T)][-1] |= (... style="")' $f \
    && ok "Guardado en ${f/#$HOME/~}"
}

# ---- eliminar
delete_res() {  # tipo nombre id
  local t=$1 name=$2 id=$3 out
  case $t in
    sqs)      out=$(awsx sqs delete-queue --queue-url $id 2>&1) ;;
    sns)      out=$(awsx sns delete-topic --topic-arn $id 2>&1) ;;
    dynamodb) out=$(awsx dynamodb delete-table --table-name $name 2>&1) ;;
    s3)       out=$(awsx s3 rb s3://$name --force 2>&1) ;;
    secrets)  out=$(awsx secretsmanager delete-secret --secret-id $name --force-delete-without-recovery 2>&1) ;;
    ssm)      out=$(awsx ssm delete-parameter --name $name 2>&1) ;;
  esac && res del $t $name || res fail $t $name "$out"
}

cmd_aws_rm() {
  need_floci || return 1
  local mode; mode=$(gum choose --header "🗑  ¿Qué eliminar? (los archivos de stack/aws no se tocan)" \
      "Elegir recursos" "Todo lo declarado en un archivo" "Todo (vaciar Floci)" "Cancelar") || return 0
  local -a inv=(${(f)"$(aws_inventory)"}) sel=() l
  (( $#inv )) || { dim "No hay recursos."; return 0 }
  case $mode in
    Elegir*)
      local -a shown=()
      for l in $inv; do shown+="${(r:9:)${l%%	*}} ${${l#*	}%%	*}"; done
      sel=(${(f)"$(print -rl -- $shown | gum filter --no-limit --header "Marca con Tab, Enter confirma" --placeholder "buscar…")"})
      (( $#sel )) || return 0
      local -a pick=() w
      for l in $sel; do w=(${=l}); pick+=(${(M)inv:#$w[1]	$w[2]	*}); done
      sel=($pick) ;;
    Todo\ lo*)
      local -a files=(${(f)"$(pick_aws_files)"}) ; (( $#files )) || return 0
      declared_index
      for l in $inv; do
        local key=${l%%	*}:${${l#*	}%%	*}
        (( ${+DECL[$key]} )) && (( ${files[(Ie)$AWS_DIR/${DECL[$key]}.yaml]} )) && sel+=$l
      done ;;
    Todo\ \(*) sel=($inv) ;;
    *) return 0 ;;
  esac
  (( $#sel )) || { dim "Nada que eliminar."; return 0 }
  gum style --foreground 214 "Se eliminará:"; for l in $sel; do print -r -- "  ${(r:9:)${l%%	*}} ${${l#*	}%%	*}"; done
  gum confirm --default=false "¿Eliminar ${#sel} recurso(s)? No se puede deshacer." || return 0
  # primero lo que depende de otros (tópicos antes que colas; colas normales antes que DLQ)
  for l in ${(M)sel:#sns	*} ${(M)sel:#sqs	*} ${sel:#(sns|sqs)	*}; do
    delete_res ${l%%	*} ${${l#*	}%%	*} ${l##*	}
  done
}

# ---- probar: mensajes, ítems, valores
pick_res() {  # tipo encabezado → imprime "nombre<TAB>id"
  local -a rows=(${(M)${(f)"$(aws_inventory)"}:#$1	*})
  (( $#rows )) || { err "No hay recursos ${AWS_TYPE_LABEL[$1]}"; return 1 }
  local sel; sel=$(print -rl -- ${${rows#*	}%%	*} | gum filter --header "$2" --placeholder "buscar…") || return 1
  print -r -- ${${(M)rows:#$1	$sel	*}#*	}
}

cmd_aws_test() {
  need_floci || return 1
  local c r name id
  c=$(gum choose --header "🧪 Probar" \
      "📨 Enviar mensaje a una cola" "👀 Ver mensajes de una cola" "📥 Consumir mensajes (los elimina)" \
      "🧹 Purgar cola" "📢 Publicar en un tópico SNS" "🗃  Ver ítems de una tabla" \
      "🔑 Ver valor de secreto / parámetro" "🪣 Ver objetos de un bucket") || return 0
  case $c in
    *Enviar*)
      r=$(pick_res sqs "Cola") || return 0; name=${r%%	*} id=${r#*	}
      local body; body=$(gum write --header "Mensaje para $name (Ctrl+D envía)" --height 8 --value '{}') || return 0
      local -a fifo=()
      if [[ $name == *.fifo ]]; then
        local g; g=$(gum input --header "MessageGroupId" --value default) || return 0
        fifo=(--message-group-id $g --message-deduplication-id ${EPOCHREALTIME/./})
      fi
      local mid; mid=$(awsx sqs send-message --queue-url $id --message-body "$body" $fifo --query MessageId 2>&1) \
        && ok "Enviado a $name (MessageId $mid)" || err "No se pudo enviar: $mid" ;;
    *Ver\ mensajes*|*Consumir*)
      r=$(pick_res sqs "Cola") || return 0; name=${r%%	*} id=${r#*	}
      local -a vt=(--visibility-timeout 0)
      [[ $c == *Consumir* ]] && vt=()
      [[ -z $vt ]] || dim "  Ojo: cada lectura cuenta para el maxReceiveCount de la DLQ."
      local raw n i b
      raw=$(awsjx sqs receive-message --queue-url $id --max-number-of-messages 10 --wait-time-seconds 1 $vt \
            --attribute-names ApproximateReceiveCount 2>&1) || { err "$raw"; return 1 }
      n=$(yq -p=json '(.Messages // []) | length' <<<"$raw")
      (( n )) || { dim "  (la cola $name no tiene mensajes visibles)"; return 0 }
      for (( i=0; i<n; i++ )); do
        gum style --foreground 6 "── $((i+1))/$n · $(yq -p=json ".Messages[$i].MessageId" <<<"$raw") · lecturas: $(yq -p=json ".Messages[$i].Attributes.ApproximateReceiveCount" <<<"$raw")"
        b=$(yq -p=json ".Messages[$i].Body" <<<"$raw")
        yq -p=json -o=json <<<"$b" 2>/dev/null || print -r -- $b
        [[ $c == *Consumir* ]] && awsx sqs delete-message --queue-url $id --receipt-handle "$(yq -p=json ".Messages[$i].ReceiptHandle" <<<"$raw")"
      done
      [[ $c == *Consumir* ]] && ok "$n mensaje(s) consumidos de $name" ;;
    *Purgar*)
      r=$(pick_res sqs "Cola a purgar") || return 0; name=${r%%	*} id=${r#*	}
      gum confirm --default=false "¿Borrar todos los mensajes de $name?" && awsx sqs purge-queue --queue-url $id && ok "$name purgada" ;;
    *Publicar*)
      r=$(pick_res sns "Tópico") || return 0; name=${r%%	*} id=${r#*	}
      local msg; msg=$(gum write --header "Mensaje para $name (Ctrl+D publica)" --height 8 --value '{}') || return 0
      local mid; mid=$(awsx sns publish --topic-arn $id --message "$msg" --query MessageId 2>&1) \
        && ok "Publicado en $name (MessageId $mid)" || err "No se pudo publicar: $mid" ;;
    *ítems*)
      r=$(pick_res dynamodb "Tabla") || return 0; name=${r%%	*}
      local out; out=$(awsjx dynamodb scan --table-name $name --max-items 50 2>&1) || { err "$out"; return 1 }
      { gum style --bold "$name · $(yq -p=json '.Count' <<<"$out") ítems (máx. 50)"
        yq -p=json -o=yaml '.Items[] | [with_entries(.value |= (to_entries | .[0].value))]' <<<"$out"
      } | gum pager ;;
    *secreto*)
      local -a both=(${(M)${(f)"$(aws_inventory)"}:#(secrets|ssm)	*})
      (( $#both )) || { err "No hay secretos ni parámetros"; return 1 }
      local sel; sel=$(print -rl -- ${both/	/ · } | sed 's/	.*//' | gum filter --header "Secreto o parámetro") || return 0
      if [[ $sel == secrets* ]]; then awsx secretsmanager get-secret-value --secret-id ${sel#secrets · } --query SecretString
      else awsx ssm get-parameter --name ${sel#ssm · } --with-decryption --query Parameter.Value; fi ;;
    *objetos*)
      r=$(pick_res s3 "Bucket") || return 0; name=${r%%	*}
      awsx s3api list-objects-v2 --bucket $name --query 'Contents[].[Key,Size,LastModified]' | nonone_rows ;;
  esac
}
nonone_rows() { sed '/^None$/d' | awk -F'\t' 'NF{printf "  %-50s %10s  %s\n",$1,$2,$3} END{if(NR==0)print "  (vacío)"}' }

# dev aws [ls|apply [archivo…]|new|rm|test] — sin argumentos, submenú
cmd_aws() {
  local sub=$1; shift 2>/dev/null
  case $sub in
    ls)    cmd_aws_ls ;;
    apply) cmd_aws_apply "$@" ;;
    new)   cmd_aws_new ;;
    rm)    cmd_aws_rm ;;
    test)  cmd_aws_test ;;
    "")    [[ -t 0 ]] || { cmd_aws_ls; return }
           submenu "☁  Recursos AWS · $FLOCI_LABEL" \
             "👀 Ver recursos|cmd_aws_ls" "📄 Crear desde archivos (stack/aws)|cmd_aws_apply" \
             "➕ Crear recurso…|cmd_aws_new" "🧪 Probar (mensajes, ítems, valores)…|cmd_aws_test" \
             "🗑  Eliminar recursos…|cmd_aws_rm" ;;
    *) err "Uso: dev aws [ls|apply [archivo…]|new|rm|test]"; return 1 ;;
  esac
}

# ================================================================ API Gateway (stack/apigw/*.yaml)
# Un archivo por microservicio con sus rutas. Eliges qué archivos o rutas están activos;
# dev lo recuerda y reconstruye el API con esa selección (mismo ID → la URL no cambia):
#   http://localhost:4566/restapis/local/local/_user_request_/<ruta>
#
#   app: hola-mundo          # = label app del Deployment
#   namespace: local         # opcional (local)
#   localPort: 9001          # único por app: puerto del Service LoadBalancer en el nodo k3d
#   containerPort: 8080      # opcional (8080)
#   routes:
#     - {method: GET, path: /hola}
#     - {method: ANY, path: "/hola/{proxy+}", target: "/{proxy}"}   # con llaves: entre comillas

ACTIVE=$CACHE/apigw-active          # rutas activas: "archivo<TAB>MÉTODO<TAB>ruta"
API_ID_FILE=$CACHE/apigw-id         # ID real del API (Floci respeta 'local'; otros emuladores no)
[[ -z $API_ID_SET && -s $API_ID_FILE ]] && API_ID=$(<$API_ID_FILE)

awsf() {  # AWS CLI contra Floci; en DRY_RUN solo imprime y devuelve un ID falso
  if [[ $DRY_RUN == 1 ]]; then
    print -r -- "  aws $*" >&2; print "id${EPOCHREALTIME#*.}"
  else
    awsx "$@"
  fi
}

route_files() { print -rl -- $ROUTES_DIR/*.yaml(N) }

# Archivos de rutas con YAML inválido (un error aquí no debe terminar borrando el API)
check_route_files() {
  local f bad=0 e
  for f in ${(f)"$(route_files)"}; do
    e=$(yq '.routes | length' $f 2>&1) || { err "${f:t}: YAML inválido → ${e##*: }"; bad=1; continue }
    [[ $e == <1-> ]] || { err "${f:t}: no tiene 'routes'"; bad=1 }
  done
  (( bad )) && dim "  Tip: en mapas en línea, rutas con llaves van entre comillas: {method: GET, path: \"/x/{id}\"}"
  return $bad
}

# Todas las rutas declaradas: "archivo<TAB>MÉTODO<TAB>ruta"
all_routes() {
  local f
  for f in ${(f)"$(route_files)"}; do
    yq '.routes[] | [(.method // "" | upcase), .path // ""] | @tsv' $f 2>/dev/null | sed "s|^|${f:t:r}	|"
  done
}
active_routes() { [[ -f $ACTIVE ]] && grep -v '^$' $ACTIVE }
fmt_route() { local f=${1%%	*} r=${1#*	}; print -r -- "${(r:16:)f} ${(r:7:)${r%%	*}} ${r#*	}" }   # para mostrar
unfmt_route() { local -a w=(${=1}); print -r -- "$w[1]	$w[2]	$w[3]" }

# ---- reconstruye el API con las rutas activas
apigw_build() {
  local -a sel=(${(f)"$(active_routes)"})
  (( $#sel )) || { dim "No hay rutas activas: nada que publicar."; return 0 }
  check_route_files || return 1
  local node=k3d-$CLUSTER-server-0   # alcanzable desde Floci por la red $NETWORK
  local -a files=(${(u)${sel%%	*}}) ; files=($ROUTES_DIR/${^files}.yaml)

  # validación de los archivos involucrados
  local -A seen_port seen_route
  local f app port m p key
  for f in $files; do
    [[ -f $f ]] || { err "No existe ${f:t} (¿lo renombraste?). Quita sus rutas de la selección."; return 1 }
    app=$(yq '.app // ""' $f) port=$(yq '.localPort // ""' $f)
    [[ -n $app && -n $port ]] || { err "${f:t}: faltan 'app' o 'localPort'"; return 1 }
    [[ -z ${seen_port[$port]} ]] || { err "localPort $port repetido en ${f:t} y ${seen_port[$port]}"; return 1 }
    seen_port[$port]=${f:t}
  done
  for key in $sel; do
    m=${${key#*	}%%	*} p=${key##*	}
    [[ $p == /* && $p != */ ]] || { err "${key%%	*}: ruta '$p' inválida (debe empezar con / y no terminar en /)"; return 1 }
    [[ $m == (GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|ANY) ]] || { err "${key%%	*}: método '$m' inválido en $p"; return 1 }
    local rk="$m $p"
    [[ -z ${seen_route[$rk]} ]] || { err "Ruta '$rk' repetida en ${key%%	*} y ${seen_route[$rk]}"; return 1 }
    seen_route[$rk]=${key%%	*}
  done

  # 1) Services LoadBalancer para que Floci llegue a cada app por el nodo k3d
  title "Publicando API Gateway '$API_ID' (${#sel} rutas de ${#files} archivo(s))"
  local manifest=$CACHE/apigw-services.yaml
  : >$manifest
  for f in $files; do
    yq '{"apiVersion": "v1", "kind": "Service",
         "metadata": {"name": .app + "-apigw", "namespace": (.namespace // "local"),
                      "labels": {"dev-scripts/apigw": "true"}},
         "spec": {"type": "LoadBalancer", "selector": {"app": .app},
                  "ports": [{"name": "http", "port": .localPort, "targetPort": (.containerPort // 8080)}]}}
        | split_doc' $f >>$manifest
    print -- --- >>$manifest
  done
  if [[ $DRY_RUN == 1 ]]; then cat $manifest
  elif cluster_running; then
    need_cluster && step "Exponiendo microservicios" $K apply -f $manifest || return 1
    apigw_prune_services $files
  else
    warn "k3d está apagado: publico el API, pero las rutas no responderán hasta encenderlo y republicar."
  fi

  # 2) API Gateway
  [[ $DRY_RUN == 1 ]] || need_floci || return 1
  [[ $DRY_RUN == 1 ]] || awsx apigateway delete-rest-api --rest-api-id $API_ID >/dev/null 2>&1
  local real
  real=$(awsf apigateway create-rest-api --name local-gateway --endpoint-configuration types=REGIONAL \
    --tags "{\"floci:override-id\":\"$API_ID\"}" --query id) || return 1
  [[ $DRY_RUN == 1 ]] && real=$API_ID
  if [[ $real != ${API_ID_SET:-local} ]]; then
    warn "El emulador ignoró el ID fijo '${API_ID_SET:-local}' (creó '$real'): la URL cambia en cada publicación."
  fi
  API_ID=$real
  [[ $DRY_RUN == 1 ]] || print -r -- $API_ID >$API_ID_FILE

  local -A RES
  local RID
  if [[ $DRY_RUN == 1 ]]; then RES[/]=root
  else RES[/]=$(awsx apigateway get-resources --rest-api-id $API_ID --query "items[?path=='/'].id")
  fi
  ensure_resource() {   # crea (si falta) cada segmento; deja el ID en RID. ojo: no usar "path" (es $PATH)
    local rpath=$1
    if [[ -n ${RES[$rpath]} ]]; then RID=${RES[$rpath]}; return; fi
    local parent=${rpath%/*}; [[ -z $parent ]] && parent=/
    ensure_resource $parent
    RID=$(awsf apigateway create-resource --rest-api-id $API_ID --parent-id $RID \
          --path-part ${rpath##*/} --query id)
    RES[$rpath]=$RID
  }

  local method target seg name file; local -a out mparams iparams mextra iextra
  for f in $files; do
    port=$(yq '.localPort' $f) file=${f:t:r}
    while IFS=$'\t' read -r method p target; do
      (( ${sel[(Ie)$file	$method	$p]} )) || continue      # solo las rutas activas
      ensure_resource $p
      # Parámetros de ruta: {channelId} o {proxy+} → se pasan tal cual al backend
      mparams=() iparams=() mextra=() iextra=()
      for seg in ${(s:/:)p}; do
        [[ $seg == \{*\} ]] || continue
        name=${${seg#\{}%\}}; name=${name%+}
        mparams+="\"method.request.path.$name\":true"
        iparams+="\"integration.request.path.$name\":\"method.request.path.$name\""
      done
      if (( $#mparams )); then
        mextra=(--request-parameters "{${(j:,:)mparams}}")
        iextra=(--request-parameters "{${(j:,:)iparams}}")
      fi
      awsf apigateway put-method --rest-api-id $API_ID --resource-id $RID \
        --http-method $method --authorization-type NONE $mextra >/dev/null || return 1
      awsf apigateway put-integration --rest-api-id $API_ID --resource-id $RID \
        --http-method $method --type HTTP_PROXY --integration-http-method $method \
        --uri "http://$node:$port$target" $iextra >/dev/null || return 1
      out+="$(printf '%-7s %s   (%s)' $method "$FLOCI/restapis/$API_ID/$STAGE/_user_request_$p" $file)"
    done < <(yq '.routes[] | [(.method | upcase), .path, (.target // .path)] | @tsv' $f)
  done

  awsf apigateway create-deployment --rest-api-id $API_ID --stage-name $STAGE >/dev/null || return 1
  ok "API Gateway publicado:"
  print -rl -- "  "$^out
}

# Borra los Services -apigw de apps que ya no tienen rutas activas
apigw_prune_services() {
  local -a want=() have f
  for f in "$@"; do want+="$(yq '(.namespace // "local") + "/" + .app + "-apigw"' $f)"; done
  have=(${(f)"$($K get svc -A -l dev-scripts/apigw=true -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{"\n"}{end}' 2>/dev/null)"})
  for f in ${have:|want}; do quiet "Quitar Service $f" $K delete svc -n ${f%%/*} ${f#*/} && dim "  - Service $f"; done
}

apigw_clear() {
  [[ $DRY_RUN == 1 ]] && { dim "  (borraría el API $API_ID y los Services -apigw)"; return 0 }
  : >$ACTIVE
  floci_up && awsx apigateway delete-rest-api --rest-api-id $API_ID >/dev/null 2>&1 && ok "API Gateway '$API_ID' eliminado"
  rm -f $API_ID_FILE
  if cluster_running && need_cluster; then
    $K delete svc -A -l dev-scripts/apigw=true >/dev/null 2>&1 && dim "  Services -apigw eliminados"
  fi
  return 0
}

# ---- publicar (elegir archivos o rutas)
cmd_apigw_publish() {
  local -a files=(${(f)"$(route_files)"})
  (( $#files )) || { err "No hay archivos de rutas en ${ROUTES_DIR/#$HOME/~} (ver hola-mundo.yaml.example)"; return 1 }
  check_route_files || return 1
  local -a all=(${(f)"$(all_routes)"}) act=(${(f)"$(active_routes)"}) new=() f
  if (( $# )); then                                 # dev apigw publish archivo…: archivos completos
    for f in "$@"; do
      f=${${f:t}%.yaml}
      [[ -f $ROUTES_DIR/$f.yaml ]] || { err "No existe ${ROUTES_DIR/#$HOME/~}/$f.yaml"; return 1 }
      new+=(${(M)all:#$f	*})
    done
  elif [[ ! -t 0 ]]; then
    new=($act)                                      # sin terminal: republica lo activo
  else
    local mode; mode=$(gum choose --header "🌐 ¿Qué publicar?" \
        "Archivos completos" "Elegir rutas una por una" \
        ${act:+"Republicar lo activo (${#act} rutas)"} "Cancelar") || return 0
    case $mode in
      Archivos*)
        local -a actf=(${(u)act%%	*}) sel
        sel=(${(f)"$(gum choose --no-limit --header "Archivos (espacio marca · los marcados quedan activos)" \
              ${actf:+--selected=${(j:,:)actf}} ${files:t:r})"}) || return 0
        for f in $sel; do new+=(${(M)all:#$f	*}); done ;;
      Elegir*)
        local -a shown=() pre=() l
        for l in $all; do shown+="$(fmt_route $l)"; (( ${act[(Ie)$l]} )) && pre+="$(fmt_route $l)"; done
        local sel; sel=$(gum choose --no-limit --height 20 --header "Rutas (espacio marca · las marcadas quedan activas)" \
              ${pre:+--selected=${(j:,:)pre}} $shown) || return 0
        for l in ${(f)sel}; do new+="$(unfmt_route $l)"; done ;;
      Republicar*) new=($act) ;;
      *) return 0 ;;
    esac
  fi
  if (( ! $#new )); then
    (( $# )) && { err "Esos archivos no tienen rutas"; return 1 }
    [[ -t 0 ]] && gum confirm --default=false "No elegiste rutas: ¿quitar todo el API Gateway?" && apigw_clear
    return 0
  fi
  [[ $DRY_RUN == 1 ]] || print -rl -- $new >$ACTIVE
  [[ $DRY_RUN == 1 ]] && { local ACTIVE=$CACHE/apigw-dry; print -rl -- $new >$ACTIVE }
  apigw_build
}

# ---- ver lo publicado (desde Floci) y la selección
cmd_apigw_ls() {
  local -a act=(${(f)"$(active_routes)"}) l
  title "🌐 API Gateway '$API_ID'"
  if floci_up && awsx apigateway get-rest-api --rest-api-id $API_ID >/dev/null 2>&1; then
    local js; js=$(awsjx apigateway get-resources --rest-api-id $API_ID 2>/dev/null)
    local -a rows=(${(f)"$(yq -p=json '.items[] | select(.resourceMethods) | .id as $id | .path as $p | .resourceMethods | keys | .[] | [$p, ., $id] | @tsv' <<<"$js")"})
    local id m p uri n=0
    for l in ${(o)rows}; do
      IFS=$'\t' read -r p m id <<<"$l"
      uri=$(awsx apigateway get-integration --rest-api-id $API_ID --resource-id $id --http-method $m --query uri 2>/dev/null)
      printf '  %-7s %-40s → %s\n' $m $p ${uri:-?}
      (( n++ ))
    done
    (( n )) || dim "  (el API existe pero no tiene rutas)"
    echo; dim "URL base: $FLOCI/restapis/$API_ID/$STAGE/_user_request_/<ruta>"
  else
    dim "  No hay API publicado en Floci."
  fi
  # diferencias entre la selección guardada y lo publicado (ej. Floci se reinició sin datos)
  if (( $#act )); then
    local -A pub; local -a falta=(); local k
    for l in ${rows:-}; do k="${${l#*	}%%	*} ${l%%	*}"; pub[$k]=1; done       # "MÉTODO ruta"
    for l in $act; do k="${${l#*	}%%	*} ${l##*	}"; (( ${+pub[$k]} )) || falta+="$(fmt_route $l)"; done
    (( $#falta )) && { echo; warn "Rutas activas que no están publicadas (republica con: dev apigw publish):"; print -rl -- "    "$^falta }
  fi
  local -a files=(${(f)"$(route_files)"})
  local -a names=(${files:t:r})
  (( $#names )) && { echo; dim "Archivos en stack/apigw: ${(j:, :)names}" }
}

# ---- quitar rutas
cmd_apigw_rm() {
  local -a act=(${(f)"$(active_routes)"}) keep=() l
  (( $#act )) || { dim "No hay rutas activas."; return 0 }
  local mode; mode=$(gum choose --header "🗑  ¿Qué quitar del API? (los archivos no se tocan)" \
      "Rutas sueltas" "Todas las rutas de un archivo" "Todo el API Gateway" "Cancelar") || return 0
  case $mode in
    Rutas*)
      local sel; sel=$(print -rl -- ${(f)"$(for l in $act; do fmt_route $l; done)"} | \
            gum filter --no-limit --header "Rutas a quitar (Tab marca)" --placeholder "buscar…") || return 0
      local -a rm=(); for l in ${(f)sel}; do rm+="$(unfmt_route $l)"; done
      keep=(${act:|rm}) ;;
    *archivo*)
      local -a fs=(${(u)act%%	*}) sel
      sel=(${(f)"$(gum choose --no-limit --header "Archivos a quitar" $fs)"}) || return 0
      for l in $act; do (( ${sel[(Ie)${l%%	*}]} )) || keep+=$l; done ;;
    Todo*)
      gum confirm --default=false "¿Eliminar el API Gateway completo?" || return 0
      apigw_clear; return ;;
    *) return 0 ;;
  esac
  print -rl -- $keep >$ACTIVE
  if (( $#keep )); then apigw_build; else apigw_clear; fi
}

# dev apigw [publish [archivo…]|ls|rm|clear] — sin argumentos, submenú
cmd_apigw() {
  local sub=$1; shift 2>/dev/null
  case $sub in
    publish) cmd_apigw_publish "$@" ;;
    ls)      cmd_apigw_ls ;;
    rm)      cmd_apigw_rm ;;
    clear)   apigw_clear ;;
    "")      [[ -t 0 ]] || { cmd_apigw_publish; return }
             submenu "🌐 API Gateway" \
               "👀 Ver rutas publicadas|cmd_apigw_ls" "🚀 Publicar / elegir rutas…|cmd_apigw_publish" \
               "🗑  Quitar rutas…|cmd_apigw_rm" ;;
    *) err "Uso: dev apigw [publish [archivo…]|ls|rm|clear]"; return 1 ;;
  esac
}

# Submenú: título "texto|función"…  (↩ Volver regresa al menú principal)
submenu() {
  local t=$1 c a m; shift
  local -a items=("$@" "↩  Volver|back")
  while true; do
    c=$(gum choose --header "$t" --cursor "➜ " --height 12 ${items%%\|*}) || return 0
    for m in $items; do [[ ${m%%\|*} == $c ]] && { a=${m##*\|}; break }; done
    [[ $a == back ]] && return 0
    $a
    echo; gum input --placeholder "Enter para continuar" >/dev/null || return 0
  done
}

cmd_help() { sed -n '2,/^$/p' $SELF | sed 's/^# \{0,1\}//' }

# ---------------------------------------------------------------- entrada
OPT_PROJECT=
while [[ $1 == -* ]]; do
  case $1 in
    -p|--project) OPT_PROJECT=$2; shift 2 ;;
    -h|--help)    set -- help ;;
    *) err "Opción desconocida: $1"; exit 1 ;;
  esac
done

case $1 in
  help)   cmd_help; exit 0 ;;
  render) check_tools yq; shift; cmd_render "$@"; exit $? ;;
esac

check_tools docker k3d kubectl yq gum aws curl
mkdir -p $AWS_DIR $ROUTES_DIR
# Con Docker apagado solo tiene sentido encender (o el menú, que muestra el estado)
if [[ -n $1 && $1 != (on|up|off|pause|power|aws|apigw) ]] && ! docker_running; then
  err "Docker está apagado. Usa: dev on"; exit 1
fi
resolve_project || exit 1

if [[ -n $1 ]]; then
  (( $+functions[cmd_$1] )) || { err "Acción desconocida: $1 (dev help)"; exit 1 }
  cmd_$1 "${@:2}"; exit $?
fi

